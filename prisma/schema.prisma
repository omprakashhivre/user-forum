generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

// generator client {
//   provider = "prisma-client-js"
// }

datasource db {
  provider = "sqlite" // Change to "postgresql" if needed
  url      = "file:./dev.db"
}


model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  forums    Forum[] 
  comments  Comment[]
  likes     Like[]
}

model Forum {
  id          String     @id @default(cuid())
  title       String
  description String
  tags        String?    
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  comments    Comment[]
  likes       Like[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  forum     Forum    @relation(fields: [forumId], references: [id], onDelete: Cascade)
  forumId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Like {
  id      String @id @default(cuid())
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)
  forumId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  @@unique([forumId, userId])
}
