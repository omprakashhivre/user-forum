// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// generator client {
//   provider = "prisma-client-js"
// }

datasource db {
  provider = "sqlite" // Change to "postgresql" if needed
  url      = "file:./dev.db"
}

model User {
  id       String    @id @default(cuid())
  name     String
  email    String    @unique
  password String
  forums   Forum[]
  comments Comment[]
  likes    Like[]
}

model Forum {
  id          String    @id @default(cuid())
  title       String
  description String
  tags        String? // JSON as string or custom logic
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  comments    Comment[]
  likes       Like[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  forum     Forum    @relation(fields: [forumId], references: [id])
  forumId   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}

model Like {
  id      String @id @default(cuid())
  forum   Forum  @relation(fields: [forumId], references: [id])
  forumId String
  user    User   @relation(fields: [userId], references: [id])
  userId  String

  @@unique([forumId, userId]) // One like per user per forum
}
